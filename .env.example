# Application
APP_ENV=local
LOG_LEVEL=info

# API
API_PORT=8008

# Database
DATABASE_URL=postgresql+psycopg://belzakupki:belzakupki@localhost:5433/belzakupki
DB_HOST=db
DB_PORT=5432
DB_NAME=belzakupki
DB_USER=belzakupki
DB_PASSWORD=belzakupki
POSTGRES_HOST_PORT=5433

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# goszakupki.by parser
GOSZAKUPKI_VERIFY_SSL=false
GOSZAKUPKI_COOKIE=

# Telegram notifications
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# API Security (required, generate a random secret with at least 32 characters)
API_SECRET_KEY=

# AI Analysis
DEEPSEEK_TOKEN=

# Worker temp directory (оставь пустым для автоматического tmpdir)
WORKER_TEMP_DIR=

# Worker resource safety (defaults target a small 4 GiB production host)
SCHEDULER_MAX_PENDING=8
SCHEDULER_JOB_TIMEOUT=3600
SCHEDULER_FAILED_JOB_TTL=300
WORKER_AI_BATCH_SIZE=10
WORKER_ROUTING_BATCH_SIZE=100
WORKER_RESULTS_BATCH_SIZE=50
WORKER_NOTIFICATION_BATCH_SIZE=50
WORKER_OCR_MAX_PAGES=12
WORKER_PDF_TEXT_MAX_PAGES=100
WORKER_MAX_ATTACHMENTS=10
WORKER_EXTRACTED_TEXT_MAX_CHARS=120000
WORKER_AI_DOCUMENT_CHARS=120000
WORKER_MEMORY_LIMIT=768m
WORKER_MEMORY_RESERVATION=384m
WORKER_CPU_LIMIT=0.75

# Independent read-only integration credential, scoped to one existing tenant
INTEGRATION_API_KEY=
INTEGRATION_TENANT_ID=
# Optional comma-separated allowed profile IDs belonging to this tenant
INTEGRATION_PROFILE_IDS=
# Archive / spreadsheet safety
WORKER_ARCHIVE_MAX_MEMBERS=100
WORKER_ARCHIVE_MAX_BYTES=52428800
WORKER_SPREADSHEET_MAX_ROWS=10000
WORKER_SPREADSHEET_MAX_COLUMNS=256
# Keep false during intake-only rollout; enable deliberately for Telegram delivery
WORKER_NOTIFICATIONS_ENABLED=true

# Existing deployments: use the EXACT current Redis /data volume name; migrate AOF first.
# Fresh deployment: deploy.sh creates this external volume under the shared-host lock.
REDIS_DATA_VOLUME=belzakupki_redis_data
